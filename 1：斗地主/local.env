# 配置模板，不含真实密钥。复制为 .env 后填写；已有 .env 不要覆盖。
# main.py 读取 .env 并转换为 Agent.config；同名系统环境变量优先。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 对应 Agent.config 的 timeout、retries、backoff。
API_TIMEOUT=120
API_RETRIES=2
API_BACKOFF=1

# 对应 max_tokens；留空表示不传该参数，上限由服务决定。
max_tokens=

# DeepSeek 思考开关：enabled / disabled；强度 low / high / max，仅开启时发送。
thinking=disabled
reasoning_effort=low
# 当前程序使用完整 JSON 响应，仅支持 false。
stream=false

# 可选：为某个玩家覆盖公共配置；Bob、Corleone 使用 BOB_、CORLEONE_ 前缀。
# ALICE_API_KEY=
# ALICE_BASE_URL=
# ALICE_MODEL=
